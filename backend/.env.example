# Java properties syntax. Do not put quotes around values; escape each backslash as \\.
# Use the existing MySQL account and password; do not put staff login credentials here.
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Optional: uncomment and change only if MySQL is not using the default local database.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sambar_spicy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&characterEncoding=UTF-8

# Optional shared cache for the customer menu. Use the private Redis URL in production.
# PUBLIC_MENU_CACHE_ENABLED=true
# REDIS_URL=redis://localhost:6379
# PUBLIC_MENU_CACHE_NAMESPACE=sambar
# REDIS_DATABASE=0
# REDIS_CONNECT_TIMEOUT=500ms
# REDIS_TIMEOUT=500ms
# For authenticated or TLS Redis, supply the provider's private redis:// or
# rediss:// URL (including URL-encoded credentials) through the environment.
# Never commit that URL. REDIS_DATABASE selects the database separately.
